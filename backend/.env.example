# Royal Scout Intelligence 2027 - Backend Configuration

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Client Configuration (CORS)
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB)
# If MongoDB is running locally or via Atlas, provide URI.
# The server will operate gracefully with or without an active connection during Phase 1.
MONGODB_URI=mongodb://localhost:27017/royal_scout_intelligence_2027

# Logging Configuration
LOG_LEVEL=info

# API Prefix
API_PREFIX=/api/v1

